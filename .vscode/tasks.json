{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:main",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "silent",

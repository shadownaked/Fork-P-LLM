{
  "name": "proxyllm",
  "version": "1.0.0",
  "description": "LLM API Proxy - Intercept and expose OpenAI-compatible API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "tsc && electron .",
    "dev:ui": "cd renderer && npm run dev",
    "dev:all": "cd renderer && npm run build && cd .. && npm run build && npm run dev",
    "dist:win": "electron-builder --win --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx ts-node scripts/test-proxy.ts",
    "test:e2e:proxy": "npx ts-node scripts/test-e2e-proxy.ts",
    "test:all": "npx ts-node scripts/run-all-tests.ts",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },
  "keywords": [
    "electron",
    "llm",
    "proxy",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.proxyllm.app",
    "productName": "ProxyLLM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "config/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "renderer/dist",
        "to": "renderer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^20.19.27",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.1",
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "node-forge": "^1.3.3",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  }
}
